{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STEN Restaurant Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "establishment_id",
    "name",
    "jurisdiction",
    "format",
    "updated_at"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "establishment_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 2
    },
    "sector": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "service_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "address": {
      "type": [
        "string",
        "null"
      ]
    },
    "timezone": {
      "type": [
        "string",
        "null"
      ]
    },
    "area_m2": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "floors": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "seats": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "max_occupancy": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "gas_equipment": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "open_fire": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "fryers": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "extraction_system": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "building_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "departments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "accounting_basis": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_metrics": {
      "type": "object"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
