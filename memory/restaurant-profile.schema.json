{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STEN HoReCa Establishment Profile",
  "description": "Tenant-scoped profile. Null or omitted means unknown, not zero, false, compliant, absent or not applicable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "establishment_id",
    "name",
    "jurisdiction",
    "primary_sector",
    "primary_format",
    "updated_at"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "establishment_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 2
    },
    "primary_sector": {
      "enum": [
        "restaurant",
        "cafe",
        "bar",
        "bakery",
        "hotel_food_service",
        "catering",
        "canteen",
        "food_hall",
        "quick_service",
        "other"
      ]
    },
    "primary_format": {
      "type": "string",
      "minLength": 1
    },
    "additional_formats": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "business_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "service_models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sales_channels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "production_models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "address": {
      "type": [
        "string",
        "null"
      ]
    },
    "timezone": {
      "type": [
        "string",
        "null"
      ]
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "area_m2": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "floors": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "seats": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "max_occupancy": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "building": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "building_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "ownership_or_lease": {
          "type": [
            "string",
            "null"
          ]
        },
        "mall_or_complex": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "hotel_integrated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "floors_used": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          }
        },
        "shared_areas": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "engineering": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gas_equipment": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "open_fire": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fryers": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "extraction_system": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fire_suppression": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "solid_fuel": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "electrical_capacity_kw": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "ventilation_details": {
          "type": [
            "string",
            "null"
          ]
        },
        "equipment_inventory_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "operating_structure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "departments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "production_sites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "central_kitchen": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "delivery_fleet": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reservation_system": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "finance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accounting_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "fiscal_period": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_metrics": {
          "type": "object"
        },
        "chart_of_accounts_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "pnl_source_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "workforce": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "employee_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "employment_models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "payroll_frequency": {
          "type": [
            "string",
            "null"
          ]
        },
        "staffing_model_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "compliance_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permits_and_licenses_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "food_safety_system": {
          "type": [
            "string",
            "null"
          ]
        },
        "fire_safety_documents_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "specialist_assessment_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "field_status": {
      "type": "object",
      "description": "Optional status by JSON Pointer: known, unknown, not_applicable, requires_confirmation."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
