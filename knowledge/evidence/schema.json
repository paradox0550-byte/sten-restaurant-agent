{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sten.example/schemas/evidence-record-v1.json",
  "title": "STEN Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "evidence_class",
    "topic",
    "source",
    "territory",
    "validity",
    "applicability",
    "limitations",
    "record_status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,100}$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "summary": {
      "type": "string"
    },
    "evidence_class": {
      "enum": [
        "LAW",
        "RESEARCH",
        "CORE",
        "INDUSTRY",
        "PRACTICE",
        "TREND",
        "HYPOTHESIS",
        "CONFIGURATION"
      ]
    },
    "topic": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisher",
        "title",
        "source_type",
        "url",
        "published_at",
        "accessed_at"
      ],
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "official_act",
            "official_guidance",
            "peer_reviewed",
            "systematic_review",
            "book",
            "industry_report",
            "professional_standard",
            "internal_methodology",
            "primary_data",
            "other"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "citation": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "source_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "territory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "jurisdictions"
      ],
      "properties": {
        "scope": {
          "enum": [
            "global",
            "regional",
            "national",
            "subnational",
            "organization",
            "establishment",
            "unknown"
          ]
        },
        "jurisdictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "published_on",
        "effective_from",
        "effective_to",
        "last_verified_at",
        "review_due_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "in_force",
            "not_yet_effective",
            "superseded",
            "repealed",
            "historical",
            "current_but_unverified",
            "not_applicable",
            "unknown"
          ]
        },
        "published_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "last_verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "review_due_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sectors",
        "formats",
        "establishment_conditions",
        "required_profile_fields",
        "determination"
      ],
      "properties": {
        "sectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "establishment_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_profile_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "determination": {
          "enum": [
            "universal_within_scope",
            "conditional",
            "profile_required",
            "specialist_review",
            "unknown"
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "related_records": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts_with": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "record_status": {
      "enum": [
        "draft",
        "reviewed",
        "approved",
        "archived",
        "quarantined"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewer_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "review_notes": {
          "type": "string"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_catalog_id": {
      "type": "string",
      "pattern": "^source\\.[a-z0-9._-]+$"
    }
  }
}
