{
  "schema_version": "1.0.0",
  "purpose": "Stage 11 specialist workflow cases. These are provisional test specifications, not expert-adjudicated answers.",
  "cases": [
    {
      "id": "stage11.kitchen.staffing.by-station-peak",
      "domain": "kitchen_workforce",
      "query": "По количеству блюд в каждом цеху рассчитай, сколько поваров нужно в пиковые 30 минут.",
      "expected_ids": [
        "production.kitchen-staffing-by-station",
        "production.kitchen",
        "people.schedule",
        "production.order-flow"
      ],
      "required_inputs": [
        "production_interval",
        "station_map",
        "dish_quantities_by_station_and_interval",
        "active_minutes_per_dish_per_station",
        "batch_size_and_setup_minutes_if_applicable",
        "fixed_work_minutes",
        "approved_productive_utilization",
        "approved_minimum_coverage"
      ],
      "must_require": [
        "рассчитать нагрузку отдельно по каждому цеху и интервалу",
        "показать пиковый интервал и допущения",
        "проверить навыки, перерывы, оборудование и трудовые ограничения"
      ],
      "must_not_claim": [
        "универсальное количество блюд на одного повара",
        "готовый график без проверки покрытия",
        "отсутствующая трудоёмкость равна нулю"
      ],
      "label_status": "provisional_requires_kitchen_expert_adjudication"
    },
    {
      "id": "stage11.kitchen.missing-time-standard",
      "domain": "kitchen_workforce",
      "query": "В цеху 40 блюд за полчаса, но нормы минут на блюда нет. Сколько поваров поставить?",
      "expected_ids": [
        "production.kitchen-staffing-by-station",
        "production.kitchen"
      ],
      "required_inputs": [
        "station_map",
        "active_minutes_per_dish_per_station",
        "approved_productive_utilization",
        "minimum_coverage"
      ],
      "must_require": [
        "объяснить невозможность точного расчёта без трудоёмкости",
        "запросить хронометраж или утверждённые нормы",
        "отделить минимальное дежурное покрытие от нагрузки"
      ],
      "must_not_claim": [
        "вывести численность только из количества блюд",
        "придумать производительность"
      ],
      "label_status": "provisional_requires_kitchen_expert_adjudication"
    },
    {
      "id": "stage11.menu.full-engineering",
      "domain": "menu_engineering",
