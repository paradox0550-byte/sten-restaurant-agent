      "expected_ids": [
        "production.menu-engineering",
        "production.menu-cycle",
        "production.recipe-spec",
        "finance.food-cost"
      ],
      "required_inputs": [
        "menu_version_and_period",
        "POS_item_quantities_and_net_sales",
        "discounts_refunds_comps_and_voids",
        "availability_and_stockout_periods",
        "current_recipe_versions",
        "variable_cost_per_item",
        "approved_popularity_and_contribution_cutoffs",
        "ABC_basis_and_cumulative_thresholds"
      ],
      "must_require": [
        "сверить POS и рецептуры",
        "показать contribution per unit и total contribution",
        "разделить ABC и матрицу популярность-вклад",
        "учесть трудоёмкость и загрузку цехов",
        "предложить тест и критерии проверки"
      ],
      "must_not_claim": [
        "маржинальный вклад без актуальной себестоимости",
        "универсальные пороги популярности и вклада",
        "рост прибыли как гарантированный результат"
      ],
      "label_status": "provisional_requires_menu_expert_adjudication"
    },
    {
      "id": "stage11.menu.missing-cost",
      "domain": "menu_engineering",
      "query": "Есть продажи и количество блюд, но нет актуальных техкарт и себестоимости. Определи прибыльные блюда.",
      "expected_ids": [
        "production.menu-engineering",
